# Application Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=study_connect_db
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Optional Cloud Database Connection String (Used on Render)
# DATABASE_URL=postgresql://user:password@host:port/database

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_study_connect_2026
JWT_EXPIRATION=7d

# Brevo (Sendinblue) HTTPS API Email Configuration (Port 443 - Works on Render Free Tier)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=denisfeyisola@gmail.com

# Throttling / Rate Limiting (1 request per 60s for OTP resends)
THROTTLE_TTL=60000
THROTTLE_LIMIT=10

# CORS
CORS_ORIGIN=*
